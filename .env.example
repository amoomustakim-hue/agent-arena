# ---------------------------------------------------------------------------
# Agent Arena — environment
#
# Safety posture (vision doc §14): this file ships read-only. Trading requires
# BOTH a PRIVATE_KEY and DRY_RUN=false, and even then the council will not send
# an order without an explicit user approval. Two independent gates.
# ---------------------------------------------------------------------------

# testnet (Shannon, chain 50312) | mainnet (5031)
NETWORK=testnet

# Never send an order, only log what would have been sent. Leave true until the
# very end. `false` is necessary but NOT sufficient to trade — see above.
DRY_RUN=true

# Read-only if unset. Unset it for every demo rehearsal.
# PRIVATE_KEY=0x...

# Scope to the DreamDEX event-contracts venue. These ids MOVE — the kit warns
# they changed three times in one week. If the doctor reports 0 markets, read
# venueId off a live market row rather than trusting this.
#   testnet 0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
#   mainnet 0x458b30c2d72bfd2c6317304a4594ecbafe5f729d3111b65fdc3a33bd48e5432d
# VENUE_ID=

# The UNDERLYING BTC/ETH spot + EMA mark. Bundled on testnet; mainnet has no
# public endpoint, so wire your own ticker there. Without this the council has
# no non-circular directional signal at all (see arena-market/signals.ts).
# PRICE_FEED_URL=
# PRICE_FEED_QUOTE=USDC

# Council LLM. Which provider `LLM_PROVIDER` selects below is what actually
# runs the debate — the other provider's block is simply unused.
#
# anthropic (default, real demo): leave ANTHROPIC_API_KEY unset if you have
# run `ant auth login` — the SDK resolves that profile automatically, and an
# unset key does NOT mean no credentials. Check with `ant auth status`.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ARENA_MODEL=claude-opus-5

# groq (free-tier testing): a real key, at console.groq.com, no billing
# required. Groq hosts open-weight models (NOT Claude) behind an OpenAI-
# compatible API, so this swaps which model argues the debate, not just
# which bill it's on — useful for proving the orchestration end to end
# (LangGraph flow, MCP tool calls, event recording, the WebSocket stream) at
# zero cost before spending on the real thing. gpt-oss-120b is one of the
# few Groq models with strict structured-output support, which the
# belief/verdict schemas need exactly as much on this path as on Claude's.
# Set LLM_PROVIDER=groq above to use these.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Replay the council against recorded fixtures instead of the live venue.
# Set true to rehearse the demo with no network at all.
ARENA_FIXTURES=false
